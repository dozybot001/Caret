caret.tenon.asia {
	import access_log
	root * __RELEASE__
	encode zstd gzip
	@app not path /vendor/*
	header @app Cache-Control "no-cache"
	header /vendor/* Cache-Control "public, max-age=31536000, immutable"
	# 没有扩展名的许可证文件按纯文本返回
	@license path_regexp ^/(LICENSE|css/codicons/LICENSE(-CODE)?|vendor/monaco-[^/]+/LICENSE)$
	header @license Content-Type "text/plain; charset=utf-8"
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; worker-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
	}
	# 维护时在服务器上建 state/maintenance，所有请求返回 503 和维护页，不用重载
	@maintenance file {
		root /opt/caret/state
		try_files maintenance
	}
	error @maintenance 503
	file_server
	handle_errors {
		@missing expression {err.status_code} == 404
		@unavailable expression {err.status_code} == 503
		handle @missing {
			rewrite * /404.html
			file_server
		}
		handle @unavailable {
			rewrite * /maintenance.html
			file_server
		}
		handle {
			rewrite * /500.html
			file_server
		}
	}
}
